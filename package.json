{
	"name": "s3-sandbox-workspace",
	"private": true,
	"license": "MPL-2.0",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"check": "pnpm run \"/^check:.*/\"",
		"check:fmt": "dprint check",
		"check:spelling": "cspell .",
		"fmt": "dprint fmt",
		"test": "vp run -r test",
		"test:breaks": "vp run -r --no-cache test:breaks",
		"test:watch": "vp run -r --parallel --no-cache test:watch",
		"change": "changeset",
		"release:version": "changeset version",
		"release:publish": "pnpm build && changeset publish",
		"workflows:update": "./scripts/update-workflows.node.ts",
		"check:vp": "vp lint --deny-warnings --report-unused-disable-directives",
		"staged": "vp staged",
		"cov": "vp run -r --no-cache cov"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@changesets/config": "4.0.1",
		"@dprint/json": "0.25.2",
		"@dprint/markdown": "0.28.2",
		"@dprint/oxc": "0.48.0",
		"@dprint/toml": "0.9.0",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "catalog:",
		"cspell": "10.4.0",
		"dprint": "0.64.3",
		"dprint-plugin-yaml": "0.6.0",
		"publint": "0.3.25",
		"typescript": "7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "26.13.0",
		"pnpm": "12.16.1"
	}
}
