{
	"name": "@beaugmented/s3-sandbox",
	"version": "0.1.2",
	"description": "A local S3-compatible server for isolated development and tests",
	"keywords": [
		"s3",
		"aws",
		"sandbox",
		"testing",
		"mock"
	],
	"homepage": "https://github.com/beaugmented/s3-sandbox",
	"bugs": {
		"url": "https://github.com/beaugmented/s3-sandbox/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/beaugmented/s3-sandbox.git",
		"directory": "packages/s3-sandbox"
	},
	"license": "MPL-2.0",
	"author": {
		"name": "Augmented",
		"url": "https://github.com/beaugmented"
	},
	"contributors": [
		{
			"name": "Jeremy Banka",
			"url": "https://github.com/jeremybanka"
		}
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/s3rver.d.mts",
			"import": "./dist/s3rver.mjs"
		},
		"./package.json": "./package.json",
		"./example/*": "./example/*"
	},
	"bin": {
		"s3-sandbox": "./dist/cli.mjs"
	},
	"files": [
		"LICENSE",
		"NOTICE",
		"LICENSES",
		"README.md",
		"AGENTS.md",
		"dist",
		"example",
		"docs",
		"src"
	],
	"scripts": {
		"build": "vp pack",
		"test": "vp test",
		"test:public": "vp test tests/public",
		"test:private": "vp test tests/private",
		"test:watch": "vp test watch",
		"test:breaks": "node ../../scripts/run-breakage.node.ts",
		"cov": "vp test --coverage"
	},
	"dependencies": {
		"@hono/node-server": "2.1.5",
		"@types/node": "26.6.5",
		"comline": "0.9.0",
		"fast-xml-parser": "5.11.2",
		"he": "2.0.0",
		"hono": "4.13.13",
		"takua": "0.2.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1154.0",
		"@aws-sdk/lib-storage": "3.1154.0",
		"@aws-sdk/s3-request-presigner": "3.1154.0",
		"@smithy/core": "3.36.0",
		"@smithy/signature-v4": "5.7.4",
		"@types/he": "1.2.3",
		"breakage": "0.8.5",
		"p-map": "7.1.1"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": "26.12.0",
		"pnpm": "12.14.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
